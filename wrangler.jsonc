{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-voice-image-generator",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // 존재하지 않는 경로는 SPA 진입점(index.html)으로 응답한다.
    "not_found_handling": "single-page-application",
    // /api/* 만 Worker가 먼저 처리하고, 나머지는 정적 자산이 먼저 응답한다.
    "run_worker_first": ["/api/*"]
  },
  // AI 제공자 선택. "mock"이면 초상을 만들지 않고, "workers-ai"면 아래 AI 바인딩으로 Flux를 호출한다.
  // 대시보드의 변수 설정으로도 덮어쓸 수 있다. README의 "AI 제공자" 절 참고.
  "vars": {
    "AI_PROVIDER": "mock"
  },
  // Workers AI 바인딩. mock 상태에서는 쓰지 않지만, 변수만 바꾸면 바로 켤 수 있도록 미리 둔다.
  // remote: true — Workers AI는 로컬 개발에서도 항상 원격 자원이므로 명시해 경고를 없앤다.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // 개인정보 원칙에 따라 요청 로그 수집(Workers Logs)은 기본 비활성화한다.
  // 운영 중 문제 분석이 필요하면 true로 바꾼다.
  "observability": {
    "enabled": false
  }
}
